MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sample_mflix
PORT=3000
# Test A/B du bouton de réservation : false remet tout le monde sur A (données conservées)
AB_ENABLED=true

# --- Sécurité ---
# Secret de signature des jetons d'annulation (réservations sans compte) : 32 caractères au moins.
#   openssl rand -hex 32
APP_SECRET=
# Comptes administrateurs (création, modification et suppression de films), séparés par des virgules.
ADMIN_EMAILS=
# TP OpenTelemetry : 1 réactive les trois défauts et le compte de démonstration (mot de passe publié). 0 par défaut.
TP_TICKETS=0
